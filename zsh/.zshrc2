# ============================================================================
#  .zshrc - Eden's Config
# ============================================================================

# --- Oh My Zsh --------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # Desativado — usando Starship

# --- Plugins -----------------------------------------------------------------
plugins=(

  zsh-syntax-highlighting
  fzf
  zsh-autosuggestions
  k
    git
    docker
    docker-compose
    sudo
    command-not-found
    copypath
    copyfile
    web-search
    dirhistory
    history
    jsontools
    zsh-autosuggestions
    zsh-completions
    fast-syntax-highlighting
    zsh-history-substring-search
)

# Carrega completions extras antes do compinit
fpath+=${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src
source $ZSH/oh-my-zsh.sh

# --- Variáveis de ambiente ---------------------------------------------------
export LANG=pt_BR.UTF-8
export LC_ALL=pt_BR.UTF-8
export EDITOR='nano'
export VISUAL='code'

# --- Mise (gerenciador de linguagens) ----------------------------------------
if command -v mise &>/dev/null; then
    eval "$(mise activate zsh)"
fi

# --- Aliases -----------------------------------------------------------------
# Navegação
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'

# Listagem (usa eza se disponível)
if command -v eza &>/dev/null; then
    alias ls='eza --icons --group-directories-first'
    alias ll='eza -la --icons --group-directories-first'
    alias lt='eza -la --icons --tree --level=2'
else
    alias ls='ls --color=auto'
    alias ll='ls -lah'
fi

# Git shortcuts
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline --graph --decorate -20'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'
alias gpl='git pull'
alias gcm='git commit -m'

# Docker shortcuts
alias dk='docker'
alias dkc='docker compose'
alias dkps='docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'
alias dkimg='docker images --format "table {{.Repository}}\t{{.Tag}}\t{{.Size}}"'
alias dkprune='docker system prune -af'

# Sistema
alias update='sudo apt update && sudo apt upgrade -y'
alias cls='clear'
alias ports='ss -tulanp'
alias myip='curl -s ifconfig.me'
alias duf='df -h | head -20'

# Bat como cat (se disponível)
if command -v batcat &>/dev/null; then
    alias cat='batcat --paging=never'
    alias bat='batcat'
fi

# Fd (no Ubuntu é fdfind)
if command -v fdfind &>/dev/null; then
    alias fd='fdfind'
fi

# --- Snippets customizados --------------------------------------------------
# Coloque seus snippets/funções aqui ou crie ~/.zsh_snippets e descomente:
# [[ -f ~/.zsh_snippets ]] && source ~/.zsh_snippets

# Função: mkcd - cria dir e entra nele
mkcd() { mkdir -p "$@" && cd "$@"; }

# Função: extract - extrai qualquer arquivo compactado
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"     ;;
            *.tar.gz)    tar xzf "$1"     ;;
            *.tar.xz)    tar xJf "$1"     ;;
            *.bz2)       bunzip2 "$1"     ;;
            *.rar)       unrar x "$1"     ;;
            *.gz)        gunzip "$1"      ;;
            *.tar)       tar xf "$1"      ;;
            *.tbz2)      tar xjf "$1"     ;;
            *.tgz)       tar xzf "$1"     ;;
            *.zip)       unzip "$1"       ;;
            *.Z)         uncompress "$1"  ;;
            *.7z)        7z x "$1"        ;;
            *)           echo "'$1' não pode ser extraído" ;;
        esac
    else
        echo "'$1' não é um arquivo válido"
    fi
}

# Função: weather - previsão do tempo
weather() { curl -s "wttr.in/${1:-Sao_Paulo}?lang=pt&format=v2"; }

# Função: cheat - cheat sheet de comandos
cheat() { curl -s "cheat.sh/$1"; }

# --- Histórico ---------------------------------------------------------------
HISTSIZE=50000
SAVEHIST=50000
HISTFILE=~/.zsh_history
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY

# --- Opções do Zsh -----------------------------------------------------------
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt CORRECT
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP

# --- Keybindings úteis -------------------------------------------------------
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char

# --- Starship prompt ----------------------------------------------------------
eval "$(starship init zsh)"

# --- FZF (se disponível) -----------------------------------------------------
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
if command -v fdfind &>/dev/null; then
    export FZF_DEFAULT_COMMAND='fdfind --type f --hidden --follow --exclude .git'
fi

export PATH="$HOME/.local/bin:$PATH"

. "$HOME/.local/bin/env"



# >>> github-multi-account >>>
# Mostra qual conta GitHub está ativa
gh-quem() {
    echo ""
    echo -e "\033[1;36m  GitHub SSH Accounts\033[0m"
    echo -e "\033[1;36m  ───────────────────\033[0m"
    local current_email=$(git config --global user.email 2>/dev/null)
    local current_user=$(git config --global user.name 2>/dev/null)

    if [ "$current_email" = "silvaxicrinho@gmail.com" ]; then
        echo -e "  \033[1;32m● job\033[0m  →  cantsixsix <silvaxicrinho@gmail.com>"
        echo -e "  \033[0;37m○ pessoal\033[0m  →  littxx <ederlanbrito@gmail.com>"
    elif [ "$current_email" = "ederlanbrito@gmail.com" ]; then
        echo -e "  \033[0;37m○ job\033[0m  →  cantsixsix <silvaxicrinho@gmail.com>"
        echo -e "  \033[1;32m● pessoal\033[0m  →  littxx <ederlanbrito@gmail.com>"
    else
        echo -e "  \033[1;33m? Nenhuma conta ativa\033[0m ($current_email)"
        echo -e "  \033[0;37m○ job\033[0m  →  cantsixsix <silvaxicrinho@gmail.com>"
        echo -e "  \033[0;37m○ pessoal\033[0m  →  littxx <ederlanbrito@gmail.com>"
    fi
    echo ""
}

# Trocar para conta 1
gh-job() {
    git config --global user.name "cantsixsix"
    git config --global user.email "silvaxicrinho@gmail.com"
    echo -e "\033[1;32m✓ Trocou para: job\033[0m (cantsixsix <silvaxicrinho@gmail.com>)"
}

# Trocar para conta 2
gh-pessoal() {
    git config --global user.name "littxx"
    git config --global user.email "ederlanbrito@gmail.com"
    echo -e "\033[1;32m✓ Trocou para: pessoal\033[0m (littxx <ederlanbrito@gmail.com>)"
}

# Testar conexão SSH das 2 contas
gh-testar() {
    echo ""
    echo -e "\033[1;36m  Testando SSH...\033[0m"
    echo -e "  \033[1mjob:\033[0m"
    ssh -T github-job 2>&1 | sed 's/^/    /'
    echo -e "  \033[1mpessoal:\033[0m"
    ssh -T github-pessoal 2>&1 | sed 's/^/    /'
    echo ""
}

# Lista todos os comandos disponíveis
gh-help() {
    echo ""
    echo -e "\033[1;36m  Comandos disponíveis:\033[0m"
    echo -e "\033[1;36m  ─────────────────────\033[0m"
    echo -e "  \033[1mgh-quem\033[0m        →  Ver qual conta está ativa"
    echo -e "  \033[1mgh-job\033[0m  →  Trocar para cantsixsix"
    echo -e "  \033[1mgh-pessoal\033[0m  →  Trocar para littxx"
    echo -e "  \033[1mgh-testar\033[0m      →  Testar conexão SSH das 2 contas"
    echo -e "  \033[1mgh-help\033[0m        →  Mostrar esta ajuda"
    echo ""
}
# <<< github-multi-account <<<

# >>> github-repos-aliases >>>
alias gh-repos-job="echo '📦 Repos cantsixsix:' && curl -s https://api.github.com/users/cantsixsix/repos | grep '\"name\"' | cut -d'\"' -f4"
alias gh-repos-pessoal="echo '📦 Repos littxx:' && curl -s https://api.github.com/users/littxx/repos | grep '\"name\"' | cut -d'\"' -f4"
alias gh-test-job="ssh -T github-job"
alias gh-test-pessoal="ssh -T github-pessoal"
# <<< github-repos-aliases <
